<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/stylesheets/style.css">
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
    <title>Document</title>
</head>
<body>
   <div class="w-full h-full bg-zinc-900 p-5 text-white  p-10 ">

    <div class=" nav mb-10 text-blue-500" >
        <a href="/read">Read User</a>
    </div>
    <h1 class="text-3xl tracking-tighter mb-5 text-xl">Update User</h1>
    
        <form action="/update/<%= user._id  %>" method="post">
            <input class="px-5  border-2  py-2 bg-transparent border-2 border-zinc-800 rounded-lg outline-none text-sm " type="text" placeholder="name" name="name" value="<%= user.name  %>">

                 <input class="px-5  border-2  py-2 bg-transparent border-2 border-zinc-800 rounded-lg outline-none text-sm " type="text" name="email" placeholder="email" value="<%= user.email %>">

                   <input class="px-5  border-2  py-2 bg-transparent border-2 border-zinc-800 rounded-lg outline-none text-sm " type="text" placeholder="image url" name="image" value="<%= user.image  %>">


                      <input id="Create" class="px-10 py-5 bg-yellow-500 rounded-md ml-5 mb-3 text-black" type="submit" value="Update User" name="submit">
        </form>
    </div>
</body>
</html>