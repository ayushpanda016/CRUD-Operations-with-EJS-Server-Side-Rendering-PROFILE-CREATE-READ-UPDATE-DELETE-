<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/stylesheets/style.css">
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
    <title>Document</title>
</head>
<body class="bg-zinc-900">
   <div class="w-full h-full bg-zinc-900 p-5 text-white  p-10 ">

<div class=" nav mb-10 text-blue-500" >
        <a href="/">Back To Home Page</a>
    </div>

    <h1 class="text-3xl tracking-tighter mb-5 text-xl">All User</h1>
     
        <div class=" users flex gap-3 flex-wrap">
 
            <% if(users.length > 0){ %>
        <% users.forEach(function(user) {  %>
       
    <div class="User w-72 p-4 bg-zinc-800 rounded-lg">

        <div class="w-full h-62 rounded-lg bg-zinc-700 overflow-hidden">
            <img class="w-full h-full object-cover" src="<%= user.image %>" alt="">
        </div>
        <h3 class="text-2xl mt-1 tracking-tighter"><%= user.name %></h3>
        <h5 class="text-zinc-500"><%= user.email %></h5>
        
        <div class="flex gap-3 ">
           <a class=" text-zinc-200" href="/edit/<%= user._id  %>">Edit User</a> 
           <a class=" text-red-500" href="/delete/<%= user._id  %>">Delete User</a> 
        
        
        </div>

    </div>


  <%  }); %>

   <%  } else { %>
    <h3 class="text-zinc-500">no users yet</h3>
    <% } %>
    
  </div>
</div>
</body>
</html>